{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dasaram-garage",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dasaram-garage-db",
      "database_id": "1a5b5e05-63ad-476c-82b5-5555d2e6b1c1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] }
}
